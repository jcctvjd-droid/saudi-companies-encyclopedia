@app.get("/api/v1/companies")
def list_companies(
    q: Optional[str] = None,
    sector: Optional[str] = None,
    activity: Optional[str] = None,
    city: Optional[str] = None,
    region: Optional[str] = None,
    company_type: Optional[str] = None,
    status: Optional[str] = None,
    page: int = 1,
    page_size: int = 20,
    sort: str = "relevance",
    db: Session = Depends(get_db),
):
    cache_key = f"companies:{q}:{sector}:{activity}:{city}:{region}:{company_type}:{status}:{page}:{page_size}:{sort}"
    cached = cache_service.get(cache_key)
    if cached:
        return cached

    total = 0
    items = []

    query = db.query(Company)
    if q:
        nq = normalize_query(q)
        query = query.filter(
            (Company.arabic_name.ilike(f"%{q}%"))
            | (Company.english_name.ilike(f"%{q}%"))
            | (Company.normalized_arabic_name.like(f"%{nq}%"))
        )
    if sector:
        query = query.join(Sector).filter(Sector.name.ilike(f"%{sector}%"))
    if city:
        query = query.join(City).filter(City.name.ilike(f"%{city}%"))
    if region:
        query = query.join(Region).filter(Region.name.ilike(f"%{region}%"))
    if company_type:
        query = query.filter(Company.company_type.ilike(f"%{company_type}%"))
    if status:
        query = query.filter(Company.status.ilike(f"%{status}%"))

    total = query.count()
    offset = (page - 1) * page_size
    rows = query.order_by(Company.updated_at.desc()).offset(offset).limit(page_size).all()

    for row in rows:
        items.append({
            "id": row.id,
            "arabic_name": row.arabic_name,
            "english_name": row.english_name,
            "sector": row.sector.name if row.sector else None,
            "city": row.city.name if row.city else None,
            "company_type": row.company_type,
            "status": row.status,
            "website": row.website,
            "branch_count": db.query(Branch).filter(Branch.company_id == row.id).count(),
            "updated_at": row.updated_at.isoformat() if row.updated_at else None,
            "source_id": row.source_id,
        })

    response = {
        "items": items,
        "page": page,
        "page_size": page_size,
        "total": total,
        "total_pages": max(1, math.ceil(total / page_size)) if total else 0,
    }
    cache_service.set(cache_key, response, ttl=300)
    return response


