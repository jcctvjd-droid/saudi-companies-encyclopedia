@app.get("/api/v1/companies/nearby")
def nearby_companies(
    latitude: float = Query(...),
    longitude: float = Query(...),
    radius: float = Query(..., description="Radius in meters"),
    page: int = 1,
    page_size: int = 20,
    db: Session = Depends(get_db),
):
    # Demo fallback using simple Euclidean approximation for distance; PostGIS will be used in production.
    rows = db.query(Company).filter(Company.latitude.isnot(None), Company.longitude.isnot(None)).all()
    matches = []
    for company in rows:
        if company.latitude is None or company.longitude is None:
            continue
        distance = ((company.latitude - latitude) ** 2 + (company.longitude - longitude) ** 2) ** 0.5 * 111000
        if distance <= radius:
            matches.append({
                "id": company.id,
                "arabic_name": company.arabic_name,
                "english_name": company.english_name,
                "latitude": company.latitude,
                "longitude": company.longitude,
                "distance_meters": round(distance, 2),
            })
    matches.sort(key=lambda x: x["distance_meters"])
    total = len(matches)
    start = (page - 1) * page_size
    items = matches[start:start + page_size]
    return {
        "items": items,
        "page": page,
        "page_size": page_size,
        "total": total,
        "total_pages": max(0, math.ceil(total / page_size)) if total else 0,
    }


