@app.get("/api/v1/search/suggestions")
def search_suggestions(q: str = Query(..., min_length=1), db: Session = Depends(get_db)):
    query = normalize_query(q)
    items = db.query(Company).filter(
        Company.normalized_arabic_name.ilike(f"%{query}%")
        | Company.normalized_english_name.ilike(f"%{query}%")
        | Company.arabic_name.ilike(f"%{q}%")
    ).limit(10).all()
    return [
        {"id": item.id, "label": item.arabic_name, "english_name": item.english_name}
        for item in items
    ]


